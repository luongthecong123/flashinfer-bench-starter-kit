    {
      "id": "EdxgJm5fGsZgHJCPALDAT",
      "type": "text",
      "x": 120,
      "y": 2511,
      "width": 422.4,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
