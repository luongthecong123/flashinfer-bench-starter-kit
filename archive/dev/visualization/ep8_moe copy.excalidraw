    {
      "id": "hYwFgIOo_eWEbd0C1qYdq",
      "type": "text",
      "x": 120,
      "y": 1346,
      "width": 1218,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4",
      "roundness": null,
      "seed": 847740962,
      "version": 1,
      "versionNonce": 325197672,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773529200000,
      "link": null,
      "locked": false,
      "text": "Before:  every GPU has [E=8, C, M]  (full E, partial S).      After:  every GPU has [G=8, local_E=1, C, M]  (full G stitched, only its 1 expert).",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Before:  every GPU has [E=8, C, M]  (full E, partial S).      After:  every GPU has [G=8, local_E=1, C, M]  (full G stitched, only its 1 expert).",
      "autoResize": true,
      "lineHeight": 1.25
    },
