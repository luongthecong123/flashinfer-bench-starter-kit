    {
      "id": "7jyA47TAIvR-NQIIodoYm",
      "type": "text",
      "x": 70,
      "y": 1102,
      "width": 924.0,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bu",
      "roundness": null,
      "seed": 1095277480,
      "version": 1,
      "versionNonce": 1731840552,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773529200000,
      "link": null,
      "locked": false,
      "text": "Steps 3, 4, 5  are IDENTICAL in both paths \u2014 same NCCL AllToAll bytes, same expert GEMM, same ZeRO-2 sharding.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Steps 3, 4, 5  are IDENTICAL in both paths \u2014 same NCCL AllToAll bytes, same expert GEMM, same ZeRO-2 sharding.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_ylS4TZSp2lt3GrL8gWaY",
      "type": "text",
      "x": 70,
      "y": 1124,
      "width": 982.8,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bv",
      "roundness": null,
      "seed": 76961469,
      "version": 1,
      "versionNonce": 289485732,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773529200000,
      "link": null,
      "locked": false,
      "text": "Steps 1, 2, 6  are replaced: sparse coordinate representation eliminates the dense [S,E,C] mask (32 M fp32 elements).",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Steps 1, 2, 6  are replaced: sparse coordinate representation eliminates the dense [S,E,C] mask (32 M fp32 elements).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sjNwkjaj9N4vFC2j_0ySz",
      "type": "text",
      "x": 70,
      "y": 1146,
      "width": 949.1999999999999,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bw",
      "roundness": null,
      "seed": 507643379,
      "version": 1,
      "versionNonce": 1389276662,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773529200000,
      "link": null,
      "locked": false,
      "text": "Step 2 + 6 work: DS = S\u00b7E\u00b7C\u00b7M \u2248 137 G  vs  Tutel = S\u00b7K\u00b7M \u2248 33 M  \u2192  ~4000\u00d7 less work in dispatch/combine kernels.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 2 + 6 work: DS = S\u00b7E\u00b7C\u00b7M \u2248 137 G  vs  Tutel = S\u00b7K\u00b7M \u2248 33 M  \u2192  ~4000\u00d7 less work in dispatch/combine kernels.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1ZhfNd-BHa8JrsdPVQSLY",
      "type": "text",
      "x": 70,
      "y": 1168,
      "width": 940.8,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bx",
      "roundness": null,
      "seed": 970715645,
      "version": 1,
      "versionNonce": 904885641,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773529200000,
      "link": null,
      "locked": false,
      "text": "Wall-time speedup at production shape (S=4096, E=8, C=1024, M=4096, depth=4, 8\u00d7H100): 1052 ms \u2192 562 ms  (1.87\u00d7).",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wall-time speedup at production shape (S=4096, E=8, C=1024, M=4096, depth=4, 8\u00d7H100): 1052 ms \u2192 562 ms  (1.87\u00d7).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HPFzuL9eiWeUubqYQrFMR",
      "type": "text",
      "x": 70,
      "y": 1190,
      "width": 974.4,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "by",
      "roundness": null,
      "seed": 1491298751,
      "version": 1,
      "versionNonce": 2110522473,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773529200000,
      "link": null,
      "locked": false,
      "text": "Why not use_tutel=True on DeepSpeedMoE? DS sets self.use_tutel = use_tutel and gate.k == 1 \u2014 silently off for top-2.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why not use_tutel=True on DeepSpeedMoE? DS sets self.use_tutel = use_tutel and gate.k == 1 \u2014 silently off for top-2.",
      "autoResize": true,
      "lineHeight": 1.25
    }
