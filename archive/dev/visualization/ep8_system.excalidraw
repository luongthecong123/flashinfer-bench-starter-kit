      "isDeleted": false,
      "boundElements": [],
      "updated": 1777555812086,
      "link": null,
      "locked": false,
      "text": "Each GPU's expert grad stays local. Optimizer state for that expert also stays local (NOT sharded).\n→ memory hotspot: ~40 GB Adam state per GPU for one 3.4 B-param expert.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each GPU's expert grad stays local. Optimizer state for that expert also stays local (NOT sharded).\n→ memory hotspot: ~40 GB Adam state per GPU for one 3.4 B-param expert.",
      "autoResize": true,
      "lineHeight": 1.25
    },
