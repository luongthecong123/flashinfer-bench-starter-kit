    },
    {
      "id": "E-LBXgjxfFfYxf-JXoXWw",
      "type": "text",
      "x": 1065,
      "y": 1334,
      "width": 234,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "e3",
      "roundness": null,
      "seed": 35523432,
      "version": 1,
      "versionNonce": 897407700,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773529200000,
      "link": null,
      "locked": false,
      "text": "(one per GPU, shape identical)",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(one per GPU, shape identical)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Y-COaoHY9arIihpIeM-KA",
      "type": "text",
      "x": 210,
      "y": 1456,
      "width": 1108.8,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "e5",
      "roundness": null,
      "seed": 310309530,
      "version": 1,
      "versionNonce": 1338647082,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773529200000,
      "link": null,
      "locked": false,
      "text": "•  The dispatched [E,C,M] tensor IS ONE per-GPU tensor — it just has shape [8, C, M]; v1's 8 boxes were 8 copies of the SAME object.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "•  The dispatched [E,C,M] tensor IS ONE per-GPU tensor — it just has shape [8, C, M]; v1's 8 boxes were 8 copies of the SAME object.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2pewaytHvKI0GQ54Gyi-I",
      "type": "text",
      "x": 210,
      "y": 1478,
      "width": 1092,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "e6",
      "roundness": null,
      "seed": 1190564540,
      "version": 1,
      "versionNonce": 1995171061,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773529200000,
      "link": null,
      "locked": false,
      "text": "•  TopK routing is the algorithmic reason a slice ends up in slot j; the colored fan-out arrows make 'token → expert e_j' visible.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "•  TopK routing is the algorithmic reason a slice ends up in slot j; the colored fan-out arrows make 'token → expert e_j' visible.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jrffk2KkARxZflBfyZRhO",
      "type": "text",
      "x": 210,
      "y": 1500,
      "width": 890.4,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "e7",
      "roundness": null,
      "seed": 1019343510,
      "version": 1,
      "versionNonce": 299740498,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773529200000,
      "link": null,
      "locked": false,
      "text": "•  AllToAll #1 then physically MOVES slot j of GPU i to GPU j (no compute, just a rearrangement of bytes).",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "•  AllToAll #1 then physically MOVES slot j of GPU i to GPU j (no compute, just a rearrangement of bytes).",
      "autoResize": true,
      "lineHeight": 1.25
    },
